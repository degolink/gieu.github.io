---
// Burbujas decorativas animadas para heros con degradado.
// El padre debe ser `relative isolate overflow-hidden` y su contenido `relative z-10`.
---

<div class="pointer-events-none absolute inset-0" aria-hidden="true" data-bubbles>
    <!-- Halo suave con degradado radial (no filter: blur), para que moverlas no repinte -->
    <div class="bubble bubble-soft bubble-a absolute -left-28 -top-28 h-96 w-96"></div>
    <div class="bubble bubble-soft bubble-b absolute -right-32 -top-24 h-[28rem] w-[28rem]"></div>
    <div class="bubble bubble-soft bubble-c absolute -bottom-40 left-1/4 h-96 w-96"></div>
    <!-- Vidrio sin backdrop-filter: detrás solo hay degradado -->
    <div class="bubble bubble-d absolute bottom-6 left-[8%] h-14 w-14 rounded-full border border-white/20 bg-white/10"></div>
    <div class="bubble bubble-e absolute right-[30%] top-6 h-20 w-20 rounded-full border border-white/10 bg-white/[0.07]"></div>
    <div class="bubble bubble-f absolute bottom-4 right-[6%] h-10 w-10 rounded-full border border-white/20 bg-white/10"></div>
</div>

<style>
    .bubble-soft { border-radius: 9999px; background: radial-gradient(circle closest-side, var(--c), transparent); }
    .bubble-a { --c: theme('colors.daisy_bush.400 / 32%'); --path: drift-1; --dur: 19s; }
    .bubble-b { --c: theme('colors.Shiraz.400 / 30%'); --path: drift-2; --dur: 23s; }
    .bubble-c { --c: theme('colors.daisy_bush.300 / 24%'); --path: drift-3; --dur: 17s; }
    .bubble-d { --path: drift-2; --dur: 13s; }
    .bubble-e { --path: drift-3; --dur: 15s; animation-delay: -4s; }
    .bubble-f { --path: drift-1; --dur: 11s; animation-delay: -7s; }

    .bubble {
        will-change: transform;
        animation: var(--path) var(--dur) cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
    }
    .is-paused .bubble { animation-play-state: paused; }

    @keyframes drift-1 {
        0%   { transform: translate3d(0, 0, 0); }
        33%  { transform: translate3d(28px, -18px, 0); }
        66%  { transform: translate3d(-12px, -32px, 0); }
        100% { transform: translate3d(18px, 10px, 0); }
    }
    @keyframes drift-2 {
        0%   { transform: translate3d(0, 0, 0) scale(1); }
        40%  { transform: translate3d(-34px, 20px, 0) scale(1.06); }
        100% { transform: translate3d(14px, 36px, 0) scale(0.97); }
    }
    @keyframes drift-3 {
        0%   { transform: translate3d(0, 0, 0); }
        50%  { transform: translate3d(24px, 22px, 0); }
        100% { transform: translate3d(-20px, -14px, 0); }
    }

    @media (prefers-reduced-motion: reduce) {
        .bubble { animation: none; }
    }
</style>

<script>
    // Pausa las burbujas fuera de pantalla o con la pestaña oculta
    document.querySelectorAll<HTMLElement>("[data-bubbles]").forEach((layer) => {
        let visible = true;
        const sync = () => layer.classList.toggle("is-paused", !visible || document.hidden);
        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            sync();
        }).observe(layer);
        document.addEventListener("visibilitychange", sync);
    });
</script>
