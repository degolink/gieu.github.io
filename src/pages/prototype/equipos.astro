                        <p class="text-lg text-cod_gray-700">{proyecto.descripcion}</p>
                        <dl class="grid grid-cols-2 gap-3 text-sm">
                            <div class="rounded-xl bg-cod_gray-100 p-3"><dt class="text-cod_gray-500">Estado</dt><dd class="font-semibold">{proyecto.estado}</dd></div>
