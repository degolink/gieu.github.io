                        {proyecto.url_vermas && (
                            <a href={proyecto.url_vermas} target="_blank" rel="noopener noreferrer" class="mt-8 rounded-xl bg-white px-6 py-3 font-semibold text-daisy_bush-800 hover:scale-105 transition">Ver más ↗</a>
