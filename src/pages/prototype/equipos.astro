---
// PROTOTIPO DESECHABLE — no es código de producción. Borrar al decidir.
// Pregunta: ¿cómo se ven la página de proyecto (con su equipo), la nueva /team con GrupLAC
// y el enlace desde «¿Quiénes somos?»? Pantallas por ?screen=proyecto|team|inicio, variantes por ?variant=A|B|C.
// Datos de GrupLAC: snapshot estático (_gruplac-mock.json), no scraping en vivo.
import BaseLayout from "../../layouts/BaseLayout.astro";
import LeadersSection from "../../components/TeamPage/LeadersSection.astro";
import MembersGrid from "../../components/TeamPage/MembersGrid.astro";
import { leaders, members, type Person } from "../../utils/peopleInfo";
import { obtenerProyectos } from "../../utils/googleSheets";
import gruplac from "./_gruplac-mock.json";

if (import.meta.env.PROD) return Astro.redirect("/404");

const SCREENS: Record<string, string[]> = {
    proyecto: ["F", "A", "B", "C"],
    team: ["F", "A", "B", "C"],
    inicio: ["B", "A"],
};
const NAMES: Record<string, string> = {
    "proyecto-F": "FINAL: C + burbujas animadas",
    "team-F": "FINAL: A + pasados por década en plegable",
    "proyecto-A": "Hero como /team + carrusel",
    "proyecto-B": "Ficha a dos columnas + líderes en grilla",
    "proyecto-C": "Hero compacto + pestañas Proyecto/Equipo",
    "team-A": "Carrusel destacados + grilla + tabla pasados",
    "team-B": "Una sola grilla + pasados por década",
    "team-C": "Grilla + pasados plegables en columnas",
    "inicio-A": "Botón bajo el texto",
    "inicio-B": "Franja de cifras con enlace",
};
const screen = SCREENS[Astro.url.searchParams.get("screen") ?? ""] ? Astro.url.searchParams.get("screen")! : "proyecto";
const variants = SCREENS[screen];
const variant = variants.includes(Astro.url.searchParams.get("variant") ?? "") ? Astro.url.searchParams.get("variant")! : variants[0];

// ---- Proyecto (datos reales de la hoja si responde) ----
const proyectos = await obtenerProyectos();
const proyecto = proyectos.find((p) => /colombia\s*programa/i.test(p.titulo)) ?? {
    titulo: "Colombia Programa",
    descripcion: "(Texto de ejemplo: la hoja no tiene fila «Colombia Programa» o no respondió.)",
    tecnologias: ["Python", "Evaluación"],
    estado: "Activo",
    año: "2024",
    imagen_url: "",
    url_vermas: "https://www.colombiaprograma.gov.co/",
};
const projectLeaders = leaders;
const projectMembers = members;

// ---- GrupLAC ----
const titleCase = (s: string) =>
    s === s.toUpperCase() ? s.toLowerCase().replace(/(^|\s)\S/g, (c) => c.toUpperCase()) : s;
const parsed = gruplac.map(({ nombre, periodo }) => {
    const [ini, fin] = periodo.split(" - ");
    return { nombre: titleCase(nombre), desde: ini.split("/")[0], hasta: fin === "Actual" ? null : fin.split("/")[0], ini, fin };
});
const activos = parsed.filter((m) => m.hasta === null).sort((a, b) => a.ini.localeCompare(b.ini, undefined, { numeric: true }));
const pasados = parsed.filter((m) => m.hasta !== null).sort((a, b) => b.fin.localeCompare(a.fin, undefined, { numeric: true }));
// Tarjeta completa: se reusa la ficha de peopleInfo si el nombre coincide (primeras 2 palabras)
const ficha = (nombre: string) => leaders.find((l) => nombre.startsWith(l.name.split(" ").slice(0, 2).join(" ")));
const destacados: Person[] = activos.flatMap((m) => {
    const f = ficha(m.nombre);
    return f ? [{ ...f, name: m.nombre, role: `Integrante desde ${m.desde}` }] : [];
});
const sencillos: Person[] = activos.filter((m) => !ficha(m.nombre)).map((m) => ({ name: m.nombre, role: `Desde ${m.desde}` }));
const todosActivos: Person[] = activos.map((m) => {
    const f = ficha(m.nombre);
    return { name: m.nombre, role: `Desde ${m.desde}`, photo: f?.photo };
});
const porDecada = Object.entries(
    pasados.reduce<Record<string, typeof pasados>>((acc, m) => {
        const d = `${m.hasta!.slice(0, 3)}0s`;
        (acc[d] ??= []).push(m);
        return acc;
    }, {}),
);
const periodo = (m: { desde: string; hasta: string | null }) => (m.desde === m.hasta ? m.desde : `${m.desde} – ${m.hasta}`);
---

<BaseLayout title="PROTOTIPO — Equipos">
    <main class="bg-white pb-32">
        <!-- Barra de pantallas (prototipo) -->
        <nav class="sticky top-0 z-50 flex justify-center gap-2 bg-yellow-200 py-2 text-sm font-semibold">
            <span class="px-2">PROTOTIPO · pantalla:</span>
            {Object.keys(SCREENS).map((s) => (
                <a href={`?screen=${s}`} class:list={["rounded px-3", s === screen ? "bg-cod_gray-900 text-white" : "underline"]}>{s}</a>
            ))}
        </nav>

        {/* ===================== PROYECTO ===================== */}
        {screen === "proyecto" && variant === "A" && (
            <>
                <section class="relative isolate mb-14 min-h-[400px] overflow-hidden bg-gradient-to-br from-daisy_bush-900 via-daisy_bush-800 to-Shiraz-800 text-cod_gray-50">
                    <div class="absolute -left-20 -top-16 h-64 w-64 rounded-full bg-daisy_bush-400/20 blur-3xl" aria-hidden="true"></div>
                    <div class="absolute -right-24 top-16 h-80 w-80 rounded-full bg-Shiraz-400/20 blur-3xl" aria-hidden="true"></div>
                    <div class="relative z-10 mx-auto flex min-h-[400px] max-w-[1140px] flex-col items-center justify-center px-6 py-10 text-center">
                        <p class="text-sm text-cod_gray-300"><a href="/web/projects" class="underline">Proyectos</a> / {proyecto.titulo}</p>
                        <h1 class="mt-4 text-4xl font-bold sm:text-6xl">{proyecto.titulo}</h1>
                        <p class="mx-auto mt-6 max-w-2xl text-lg text-cod_gray-200">{proyecto.descripcion}</p>
                        <div class="mt-6 flex flex-wrap justify-center gap-2 text-sm">
                            <span class="rounded-full bg-white/15 px-3 py-1">Estado: {proyecto.estado}</span>
                            <span class="rounded-full bg-white/15 px-3 py-1">Año: {proyecto.año}</span>
