                        )}
                    </div>
                </section>
                <section class="bg-cod_gray-100 px-6 py-16">
                    <h2 class="mb-10 text-center text-3xl font-bold text-daisy_bush-700">Equipo del proyecto</h2>
                    <h3 class="mx-auto mb-6 max-w-[1300px] text-xl font-bold text-cod_gray-800">Líderes</h3>
                    <div class="mx-auto grid max-w-[1300px] gap-6 md:grid-cols-2 lg:grid-cols-3">
                        {projectLeaders.map((l) => (
                            <article class="rounded-2xl bg-white p-6 shadow">
                                <div class="flex items-center gap-4">
                                    {l.photo && <img src={l.photo} alt={`Foto de ${l.name}`} class="h-20 w-20 rounded-full bg-daisy_bush-400 object-cover object-top" />}
                                    <div><p class="font-bold text-daisy_bush-700">{l.name}</p><p class="text-sm font-bold text-cod_gray-700">{l.role}</p></div>
                                </div>
                                <p class="mt-4 line-clamp-4 text-sm text-cod_gray-700">{l.description}</p>
                            </article>
                        ))}
