---
import BaseLayout from "../layouts/BaseLayout.astro";
import LeadersSection from "../components/TeamPage/LeadersSection.astro";
import MembersGrid from "../components/TeamPage/MembersGrid.astro";
import HeroBubbles from "../components/common/HeroBubbles.astro";
import { leaders, memberPhotos, type Person } from "../utils/peopleInfo";
import { obtenerIntegrantes, pasadosPorDecada, periodo } from "../utils/gruplac";

const { activos, pasados } = obtenerIntegrantes();

// Tarjeta completa si la persona ya tiene ficha (foto y descripción) en peopleInfo.
// GrupLAC usa el nombre completo ("Camilo Vieira Mejia"); se compara por las dos primeras palabras.
const ficha = (nombre: string) =>
    leaders.find((l) => `${nombre} `.startsWith(`${l.name.split(" ").slice(0, 2).join(" ")} `));

const destacados: Person[] = activos.flatMap((m) => {
    const f = ficha(m.nombre);
    return f ? [{ ...f, name: m.nombre, role: `Integrante desde ${m.desde}` }] : [];
});
const otrosActivos: Person[] = activos
    .filter((m) => !ficha(m.nombre))
    .map((m) => ({
        name: m.nombre,
        role: periodo(m),
        photo: memberPhotos[m.nombre.normalize("NFD").replace(/\p{Diacritic}/gu, "").toLowerCase()],
    }));
const decadas = pasadosPorDecada(pasados);
---

<BaseLayout title="Equipo - GIEU - Grupo de Investigación en Informática Educativa">

    <main>

        <!-- Team Hero Section -->
    <section
        class="relative isolate mb-14 min-h-[400px] overflow-hidden bg-gradient-to-br from-cod_gray-900 via-cod_gray-800 to-cod_gray-700 text-cod_gray-50"
        aria-labelledby="team-title"
    >
        <HeroBubbles />

        <!-- Hero content -->
        <div class="relative z-10 mx-auto flex min-h-[400px] max-w-[1140px] items-center justify-center px-6 py-6 text-center sm:px-10">
            <div class="max-w-3xl animate-fade-in">
                <h1
                    id="team-title"
                    class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl md:text-6xl"
                >
                    Conoce a nuestro <span class="bg-gradient-to-r from-Shiraz-400 to-Shiraz-300 bg-clip-text text-transparent">equipo</span>
                </h1>

                <p class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-cod_gray-200 sm:text-xl">
                    Conoce a las personas que hacen posible nuestro trabajo, investigación e innovación educativa.
                </p>
            </div>
        </div>
    </section>

        <div class="h-[68px]" aria-hidden="true"></div>
        <LeadersSection leaders={destacados} />
        <MembersGrid members={otrosActivos} />

        <!-- Past members (GrupLAC), collapsible -->
        {pasados.length > 0 && (
            <section class="mx-auto mb-24 max-w-[1140px] px-6">
                <details class="group rounded-2xl border bg-white p-6" data-animated-details>
                    <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg text-2xl font-bold text-daisy_bush-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-daisy_bush-700">
                        Miembros pasados ({pasados.length})
                        <span class="chevron" aria-hidden="true">▾</span>
                    </summary>
                    <div class="overflow-hidden" data-details-body>
                        <div class="grid gap-8 pt-8 md:grid-cols-3">
                            {decadas.map(([decada, lista], i) => (
                                <div class="decade" style={`--i:${i}`}>
                                    <h3 class="mb-3 font-bold text-Shiraz-700">Hasta los {decada}s</h3>
                                    <ul class="space-y-1 text-sm">
                                        {lista.map((m) => (
                                            <li>{m.nombre} <span class="text-cod_gray-500">· {periodo(m)}</span></li>
                                        ))}
                                    </ul>
                                </div>
                            ))}
                        </div>
                    </div>
                </details>
                <p class="mt-3 text-sm text-cod_gray-500">
                    Fuente: <a class="underline hover:text-daisy_bush-700" href="https://scienti.minciencias.gov.co/gruplac/jsp/visualiza/visualizagr.jsp?nro=00000000008079" target="_blank" rel="noopener noreferrer">GrupLAC – Minciencias</a>
                </p>
            </section>
        )}

    </main>

    <style>
        @keyframes fade-in {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fade-in {
            animation: fade-in 1s ease-out;
        }

        /* Past members collapsible */
        .chevron { display: inline-block; transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1); }
        details.is-open .chevron { transform: rotate(180deg); }
        .decade { opacity: 0; transform: translateY(8px); transition: opacity 280ms ease-out, transform 360ms cubic-bezier(0.16, 1, 0.3, 1); }
        details.is-open .decade { opacity: 1; transform: none; transition-delay: calc(80ms + var(--i) * 50ms); }
        details:not(.is-open) .decade { transition-duration: 150ms; transition-delay: 0ms; }

        @media (prefers-reduced-motion: reduce) {
            .animate-fade-in {
                animation: none;
            }
            .chevron { transition: none; }
            .decade, details.is-open .decade { transform: none; transition: opacity 200ms ease-out; transition-delay: 0ms; }
        }
    </style>

    <script>
        // Animated <details>: height via WAAPI, can be interrupted midway
        const reduce = matchMedia("(prefers-reduced-motion: reduce)");
        document.querySelectorAll<HTMLDetailsElement>("[data-animated-details]").forEach((details) => {
            const summary = details.querySelector("summary")!;
            const body = details.querySelector<HTMLElement>("[data-details-body]")!;
            let anim: Animation | null = null;

            const run = (opening: boolean) => {
                const from = body.getBoundingClientRect().height; // current height, even mid-animation
                anim?.cancel();
                if (opening) details.open = true;
                details.classList.toggle("is-open", opening);
                if (reduce.matches) {
                    if (!opening) details.open = false;
                    return;
                }
                anim = body.animate([{ height: `${from}px` }, { height: `${opening ? body.scrollHeight : 0}px` }], {
                    duration: opening ? 380 : 240,
                    easing: opening ? "cubic-bezier(0.16, 1, 0.3, 1)" : "cubic-bezier(0.4, 0, 1, 1)",
                });
                anim.onfinish = () => {
                    anim = null;
                    if (!opening) details.open = false;
                };
            };

            summary.addEventListener("click", (e) => {
                e.preventDefault();
                run(!details.classList.contains("is-open"));
            });
        });
    </script>
</BaseLayout>
